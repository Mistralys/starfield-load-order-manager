<Application x:Class="LoadOrderKeeper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:LoadOrderKeeper.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <materialDesign:BundledTheme BaseTheme="Dark"
                                 PrimaryColor="Lime"
                                 SecondaryColor="LightGreen" />

                <!-- Temporary fix for MaterialDesign colors not recognized under .NET9. 
                Wait for updates and remove this fix once the `Tertiary` and `Error` colors
                are available in the schema and can be used. -->
                <ResourceDictionary>
                    <Color x:Key="MaterialDesign.Color.Tertiary">#FFB000</Color>
                    <Color x:Key="MaterialDesign.Color.Error">#FF5449</Color>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Tertiary" Color="{StaticResource MaterialDesign.Color.Tertiary}" />
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Error" Color="{StaticResource MaterialDesign.Color.Error}" />

                    <SolidColorBrush x:Key="MaterialDesign.Brush.TertiaryContainer" Color="#554400" />
                    <SolidColorBrush x:Key="MaterialDesign.Brush.ErrorContainer" Color="#93000A" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <converters:ActiveProfileVisibilityConverter x:Key="ActiveProfileVisibilityConverter" />

            <Style x:Key="MaterialDesignCompactOutlinedSecondaryButton"
                   TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignOutlinedSecondaryButton}">
                <Setter Property="Padding" Value="4,1" />
                <Setter Property="Height" Value="24" />
            </Style>

            <Style x:Key="MaterialDesignDefaultWindowStyle"
                   TargetType="Window"
                   BasedOn="{StaticResource {x:Type Window}}">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
