<UserControl x:Class="LoadOrderKeeper.Controls.ConfigInvalidOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=controls:ConfigInvalidOverlay}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    
    <!-- Semi-transparent dark background -->
    <Grid Background="#CC000000">
        <!-- Centered message card -->
        <Border Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="8"
                Padding="32"
                MaxWidth="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Effect="{StaticResource MaterialDesignElevationShadow4}">
            <StackPanel>
                <!-- Error icon -->
                <materialDesign:PackIcon Kind="AlertCircle"
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,24"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                
                <!-- Title -->
                <TextBlock Text="Configuration Required"
                          Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                          Foreground="{DynamicResource MaterialDesignBody}"
                          TextAlignment="Center"
                          Margin="0,0,0,16" />
                
                <!-- Message -->
                <TextBlock TextWrapping="Wrap"
                          TextAlignment="Center"
                          Style="{StaticResource MaterialDesignBody1TextBlock}"
                          Foreground="{DynamicResource MaterialDesignBody}"
                          LineHeight="24"
                          Margin="0,0,0,8">
                    <Run Text="The application configuration is invalid and must be fixed before this window can be used." />
                </TextBlock>
                
                <!-- Guidance -->
                <TextBlock TextWrapping="Wrap"
                          TextAlignment="Center"
                          Style="{StaticResource MaterialDesignBody2TextBlock}"
                          Foreground="{DynamicResource MaterialDesignBodyLight}"
                          LineHeight="20"
                          Margin="0,0,0,16">
                    <Run Text="Please open the settings dialog from the main window to fix the configuration. This window will remain open and become usable again when the configuration is valid." />
                </TextBlock>
                
                <!-- Reassurance -->
                <Border Background="{DynamicResource MaterialDesignDivider}"
                        CornerRadius="4"
                        Padding="16,12">
                    <TextBlock TextWrapping="Wrap"
                              TextAlignment="Center"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                              FontStyle="Italic"
                              LineHeight="18">
                        <Run Text="Your window state is preserved. All functionality will be restored automatically when the configuration is fixed." />
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
