<Window x:Class="LoadOrderKeeper.Views.CommentInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        d:Title="Enter Comment"
        Height="250"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignDefaultWindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="NoResize"
        d:DesignHeight="250" d:DesignWidth="500">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Prompt Text -->
        <TextBlock Grid.Row="0"
                   Text="{Binding PromptText}"
                   d:Text="Please enter your comment below:"
                   FontSize="14"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MaterialDesignBody}" />

        <!-- Comment Input -->
        <TextBox Grid.Row="1"
                 Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                 d:Text="This is a sample comment."
                 materialDesign:HintAssist.Hint="{Binding CommentPlaceholder}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 VerticalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxLength="500"
                 Margin="0,0,0,16"
                 Foreground="{DynamicResource MaterialDesignBody}"
                 materialDesign:TextFieldAssist.TextBoxViewMargin="0" />

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="{Binding OkButtonText}"
                    d:Content="OK"
                    Width="100"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Command="{Binding OkCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button Content="{Binding CancelButtonText}"
                    d:Content="Cancel"
                    Width="100"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
        </StackPanel>
    </Grid>
</Window>
