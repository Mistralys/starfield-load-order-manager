<Window x:Class="LoadOrderKeeper.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LoadOrderKeeper.Models"
        xmlns:converters="clr-namespace:LoadOrderKeeper.Converters"
        xmlns:controls="clr-namespace:LoadOrderKeeper.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding Title}"
        d:Title="Diff Window"
        Height="494"
        Width="1060"
        MinWidth="720"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource MaterialDesignDefaultWindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ReplacementCommandParameterConverter x:Key="ReplacementCommandParameterConverter" />
        <converters:BoolToChevronKindConverter x:Key="BoolToChevronKindConverter" />
    </Window.Resources>
    <Grid>
        <DockPanel Margin="16" Background="{DynamicResource MaterialDesignPaper}">
            <Menu DockPanel.Dock="Top" 
                  Margin="-16,-16,-16,8"
                  Background="{DynamicResource MaterialDesignPaper}"
                  Style="{StaticResource MaterialDesignMenu}">
                <MenuItem Header="{Binding FileMenuHeader}" d:Header="_File">
                    <MenuItem Header="{Binding OpenPluginsMenuText}"
                              d:Header="Open _Plugins.txt"
                              Command="{Binding OpenPluginsFileCommand}" />
                    <MenuItem Header="{Binding OpenReferenceMenuText}"
                              d:Header="Open _Reference File"
                              Command="{Binding OpenReferenceFileCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding OpenAppDataFolderMenuText}"
                              d:Header="Open _AppData Folder"
                              Command="{Binding OpenAppDataFolderCommand}" />
                    <MenuItem Header="{Binding OpenGameFolderMenuText}"
                              d:Header="Open _Game Folder"
                              Command="{Binding OpenGameFolderCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding ExitMenuText}"
                              d:Header="E_xit"
                              Click="OnCloseClicked" />
                </MenuItem>
                <MenuItem Header="{Binding EditMenuHeader}" d:Header="_Edit">
                    <MenuItem Header="{Binding FixLoadOrderButtonText}"
                              d:Header="Sort mods"
                              Command="{Binding FixLoadOrderCommand}"
                              IsEnabled="{Binding HasDifferences}" />
                    <MenuItem Header="{Binding UpdateReferenceButtonText}"
                              d:Header="Save to reference"
                              ToolTip="{Binding UpdateReferenceButtonTooltip}"
                              ToolTipService.ShowOnDisabled="True"
                              Command="{Binding UpdateReferenceCommand}"
                              IsEnabled="{Binding HasDifferences}" />
                    <Separator />
                    <MenuItem Header="{Binding DiscardChangesButtonText}"
                              d:Header="Restore from reference"
                              ToolTip="{Binding DiscardChangesButtonTooltip}"
                              ToolTipService.ShowOnDisabled="True"
                              Command="{Binding DiscardChangesCommand}"
                              IsEnabled="{Binding HasDifferences}" />
                </MenuItem>
            </Menu>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Description}"
                           d:Text="Window abstract text"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesignBody}" />

                <CheckBox Grid.Row="1"
                          Content="{Binding ShowAllModsToggleText}"
                          IsChecked="{Binding ShowAllMods, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Foreground="{DynamicResource MaterialDesignBody}"
                          Margin="0,4,0,4"
                          HorizontalAlignment="Left" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="180" />
                    </Grid.ColumnDefinitions>

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"
                                  Cursor="SizeWE"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- Diff list (column 0) -->
                    <Border Grid.Column="0"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Background="{DynamicResource MaterialDesignCardBackground}">
                    <ListView x:Name="DiffListView" ItemsSource="{Binding FilteredDiffLines}"
                              Margin="0"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Style="{StaticResource MaterialDesignContextMenu}"
                                                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{Binding ReEnableModMenuText}"
                                                      d:Header="Re-enable mod"
                                                      Command="{Binding ReEnableModCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.ChangeType, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                         Value="{x:Static models:DiffChangeType.Removed}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="{Binding ReplaceWithMenuText}"
                                                      d:Header="Replace with...">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding PlacementTarget.DataContext.ChangeType, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                               Value="{x:Static models:DiffChangeType.Removed}" />
                                                                    <Condition Binding="{Binding HasAddedMods}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                                <MenuItem.ItemsSource>
                                                    <Binding Path="AddedMods" />
                                                </MenuItem.ItemsSource>
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                        <Setter Property="Header" Value="{Binding FileName}" />
                                                        <Setter Property="Command" Value="{Binding DataContext.ReplaceRemovedModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="CommandParameter">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource ReplacementCommandParameterConverter}">
                                                                    <Binding />
                                                                    <Binding RelativeSource="{RelativeSource AncestorType=ContextMenu}" Path="PlacementTarget.DataContext" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                            <MenuItem Header="{Binding RemoveModMenuText}"
                                                      d:Header="Remove mod"
                                                      Command="{Binding RemoveNewModCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.ChangeType, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                         Value="{x:Static models:DiffChangeType.Added}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Added}">
                                        <Setter Property="Background" Value="{DynamicResource DiffBrush.Added}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Removed}">
                                        <Setter Property="Background" Value="{DynamicResource DiffBrush.Removed}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Inserted}">
                                        <Setter Property="Background" Value="{DynamicResource DiffBrush.Inserted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Moved}">
                                        <Setter Property="Background" Value="{DynamicResource DiffBrush.Moved}" />
                                        <Setter Property="ContextMenu" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Replaced}">
                                        <Setter Property="Background" Value="{DynamicResource DiffBrush.Replaced}" />
                                        <Setter Property="ContextMenu" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Unchanged}">
                                        <Setter Property="Background" Value="{DynamicResource DiffBrush.Context}" />
                                        <Setter Property="ContextMenu" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Separator}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="ContextMenu" Value="{x:Null}" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DiffLineModel}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <!-- Line number -->
                                        <TextBlock Text="{Binding FormattedLineNumber}"
                                                   FontFamily="Consolas, Courier New, monospace"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Unchanged}">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Status icon -->
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,6,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <!-- Default: no icon for Unchanged (hidden to preserve column width) -->
                                                    <Setter Property="Kind" Value="Circle" />
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Setter Property="Foreground" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Added}">
                                                            <Setter Property="Kind" Value="PlusCircleOutline" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DiffBrush.AddedForeground}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="ToolTip" Value="{Binding DataContext.AddedTooltip, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Removed}">
                                                            <Setter Property="Kind" Value="MinusCircleOutline" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DiffBrush.RemovedForeground}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="ToolTip" Value="{Binding DataContext.RemovedTooltip, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Moved}">
                                                            <Setter Property="Kind" Value="SwapVertical" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DiffBrush.MovedForeground}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="ToolTip" Value="{Binding DataContext.MovedTooltip, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Replaced}">
                                                            <Setter Property="Kind" Value="SwapHorizontal" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DiffBrush.ReplacedForeground}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="ToolTip" Value="{Binding DataContext.ReplacedTooltip, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Inserted}">
                                                            <Setter Property="Kind" Value="ArrowUpCircleOutline" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DiffBrush.InsertedForeground}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="ToolTip" Value="{Binding DataContext.InsertedWarningTooltip, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MaterialDesignBody}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Unchanged}">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Separator}">
                                                            <Setter Property="Opacity" Value="0.35" />
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasDependentChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Content="{Binding DependentChangesSummary}"
                                                Margin="20,2,4,2"
                                                Padding="4,2"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                FontSize="12"
                                                Command="{Binding Tag.ToggleDependentChangesCommand, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                                CommandParameter="{Binding}" />

                                        <ScrollViewer MaxHeight="200"
                                                      Margin="36,0,4,2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding IsDependentChangesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl ItemsSource="{Binding DependentChanges}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                                            <TextBlock Text="{Binding Prefix}"
                                                                       FontWeight="Bold"
                                                                       Width="16"
                                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                            <TextBlock Text="{Binding Text}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </Border>

                    <!-- Recommendations sidebar (column 2) -->
                    <Border Grid.Column="2"
                            Margin="8,0,0,0"
                            Background="{DynamicResource DiffBrush.GuidanceSidebarBackground}"
                            BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding GuidanceSidebarTitle}"
                                           d:Text="Recommendations"
                                           FontWeight="SemiBold"
                                           Margin="4,0,4,8"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MaterialDesignBody}" />

                                <!-- Removal card — High Risk (red) -->
                                <materialDesign:Card UniformCornerRadius="8"
                                                     Margin="0,0,0,8"
                                                     Background="{DynamicResource DiffBrush.GuidanceRemovalBackground}"
                                                     Visibility="{Binding ShowRemovalGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="10,8">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding ToggleRemovalCardCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0"
                                                                         Kind="AlertCircleOutline"
                                                                         Width="18" Height="18"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"
                                                                         Foreground="{DynamicResource DiffBrush.RemovedForeground}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding GuidanceRemovalTitle}"
                                                           d:Text="Removed Mods — High Risk"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBody}" />
                                                <materialDesign:PackIcon Grid.Column="2"
                                                                         Kind="{Binding IsRemovalCardExpanded, Converter={StaticResource BoolToChevronKindConverter}}"
                                                                         Width="16" Height="16"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            </Grid>
                                        </Button>
                                        <StackPanel Visibility="{Binding IsRemovalCardExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding RemovedModCountText}"
                                                       d:Text="1 mod removed"
                                                       FontSize="11"
                                                       Margin="0,0,0,4"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding GuidanceRemovalBody}"
                                                       d:Text="Removing mods mid-playthrough can corrupt saves."
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Insertion card — Moderate Risk (orange) -->
                                <materialDesign:Card UniformCornerRadius="8"
                                                     Margin="0,0,0,8"
                                                     Background="{DynamicResource DiffBrush.GuidanceInsertionBackground}"
                                                     Visibility="{Binding ShowInsertionGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="10,8">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding ToggleInsertionCardCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0"
                                                                         Kind="ArrowUpCircleOutline"
                                                                         Width="18" Height="18"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"
                                                                         Foreground="{DynamicResource DiffBrush.InsertedForeground}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding GuidanceInsertionTitle}"
                                                           d:Text="Inserted Mods — Moderate Risk"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBody}" />
                                                <materialDesign:PackIcon Grid.Column="2"
                                                                         Kind="{Binding IsInsertionCardExpanded, Converter={StaticResource BoolToChevronKindConverter}}"
                                                                         Width="16" Height="16"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            </Grid>
                                        </Button>
                                        <StackPanel Visibility="{Binding IsInsertionCardExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding InsertedModCountText}"
                                                       d:Text="1 mod inserted"
                                                       FontSize="11"
                                                       Margin="0,0,0,4"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding GuidanceInsertionBody}"
                                                       d:Text="Mods inserted out of order may cause instability."
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Replacement card — Safe (purple) -->
                                <materialDesign:Card UniformCornerRadius="8"
                                                     Margin="0,0,0,8"
                                                     Background="{DynamicResource DiffBrush.GuidanceReplacementBackground}"
                                                     Visibility="{Binding ShowReplacementGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="10,8">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding ToggleReplacementCardCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0"
                                                                         Kind="SwapHorizontal"
                                                                         Width="18" Height="18"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"
                                                                         Foreground="{DynamicResource DiffBrush.GuidanceReplacementForeground}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding GuidanceReplacementTitle}"
                                                           d:Text="Replaced Mods — Safe"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBody}" />
                                                <materialDesign:PackIcon Grid.Column="2"
                                                                         Kind="{Binding IsReplacementCardExpanded, Converter={StaticResource BoolToChevronKindConverter}}"
                                                                         Width="16" Height="16"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            </Grid>
                                        </Button>
                                        <StackPanel Visibility="{Binding IsReplacementCardExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ReplacedModCountText}"
                                                       d:Text="1 mod replaced"
                                                       FontSize="11"
                                                       Margin="0,0,0,4"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding GuidanceReplacementBody}"
                                                       d:Text="Replacing a mod with another is generally safe."
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Added card — Safe (green) -->
                                <materialDesign:Card UniformCornerRadius="8"
                                                     Margin="0,0,0,8"
                                                     Background="{DynamicResource DiffBrush.GuidanceAddedBackground}"
                                                     Visibility="{Binding ShowAddedGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="10,8">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding ToggleAddedCardCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0"
                                                                         Kind="PlusCircleOutline"
                                                                         Width="18" Height="18"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"
                                                                         Foreground="{DynamicResource DiffBrush.AddedForeground}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding GuidanceAddedTitle}"
                                                           d:Text="New Mods — Safe"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBody}" />
                                                <materialDesign:PackIcon Grid.Column="2"
                                                                         Kind="{Binding IsAddedCardExpanded, Converter={StaticResource BoolToChevronKindConverter}}"
                                                                         Width="16" Height="16"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            </Grid>
                                        </Button>
                                        <StackPanel Visibility="{Binding IsAddedCardExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding AddedModCountText}"
                                                       d:Text="1 mod added"
                                                       FontSize="11"
                                                       Margin="0,0,0,4"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding GuidanceAddedBody}"
                                                       d:Text="Adding new mods is generally safe."
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Moved card — Informational (blue) -->
                                <materialDesign:Card UniformCornerRadius="8"
                                                     Margin="0,0,0,8"
                                                     Background="{DynamicResource DiffBrush.GuidanceMovedBackground}"
                                                     Visibility="{Binding ShowMovedGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="10,8">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding ToggleMovedCardCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0"
                                                                         Kind="SwapVertical"
                                                                         Width="18" Height="18"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"
                                                                         Foreground="{DynamicResource DiffBrush.GuidanceMovedForeground}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding GuidanceMovedTitle}"
                                                           d:Text="Moved Mods — Informational"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBody}" />
                                                <materialDesign:PackIcon Grid.Column="2"
                                                                         Kind="{Binding IsMovedCardExpanded, Converter={StaticResource BoolToChevronKindConverter}}"
                                                                         Width="16" Height="16"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            </Grid>
                                        </Button>
                                        <StackPanel Visibility="{Binding IsMovedCardExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding MovedModCountText}"
                                                       d:Text="1 mod moved"
                                                       FontSize="11"
                                                       Margin="0,0,0,4"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding GuidanceMovedBody}"
                                                       d:Text="These mods changed position due to other changes."
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- No Changes card -->
                                <!-- Intentionally no Background: neutral state uses MD card default.
                                     The four risk-level cards above each carry an explicit DiffBrush.Guidance*Background
                                     value; this card deliberately omits one to avoid implying a risk level. -->
                                <materialDesign:Card UniformCornerRadius="8"
                                                     Margin="0,0,0,8"
                                                     Visibility="{Binding ShowNoChangesGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="10,8">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding ToggleNoChangesCardCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0"
                                                                         Kind="CheckCircleOutline"
                                                                         Width="18" Height="18"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding GuidanceNoChangesTitle}"
                                                           d:Text="No Changes"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBody}" />
                                                <materialDesign:PackIcon Grid.Column="2"
                                                                         Kind="{Binding IsNoChangesCardExpanded, Converter={StaticResource BoolToChevronKindConverter}}"
                                                                         Width="16" Height="16"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            </Grid>
                                        </Button>
                                        <StackPanel Visibility="{Binding IsNoChangesCardExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding GuidanceNoChangesBody}"
                                                       d:Text="Your load order matches the reference."
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                </Grid>

                <!-- Sorting Recommendation Banner -->
                <Border Grid.Row="3"
                        Margin="0,8,0,0"
                        Background="{DynamicResource DiffBrush.SortingBannerBackground}"
                        BorderBrush="{DynamicResource DiffBrush.SortingBannerBorder}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Padding="12,8"
                        Visibility="{Binding ShowSortingRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding FixLoadOrderCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sort" 
                                                         Width="16" 
                                                         Height="16"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,4,0" />
                                <TextBlock Text="{Binding FixLoadOrderButtonText}"
                                           d:Text="Sort now"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <materialDesign:PackIcon Kind="Sort" 
                                                DockPanel.Dock="Left"
                                                Width="20" 
                                                Height="20"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                Foreground="{DynamicResource MaterialDesignPaper}" />
                        <TextBlock Text="{Binding SortingRecommendationMessage}"
                                   d:Text="Sorting recommendation message"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MaterialDesignPaper}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                
                <TextBlock Grid.Row="4"
                           Text="{Binding DiffStatusMessage}"
                           d:Text="Status message"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Row="5"
                            Text="{Binding NoDifferencesMessage}"
                            d:Text="No differences detected."
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource MaterialDesignBodyLight}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDifferences}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Row="6"
                             Orientation="Horizontal"
                             HorizontalAlignment="Right"
                             Margin="0,16,0,0">
                    <Button Margin="8,0,0,0"
                            Command="{Binding FixLoadOrderCommand}"
                            IsEnabled="{Binding HasDifferences}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Sort" 
                                                     Width="16" 
                                                     Height="16"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,4,0" />
                            <TextBlock Text="{Binding FixLoadOrderButtonText}"
                                       d:Text="Sort mods"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0"
                            Command="{Binding UpdateReferenceCommand}"
                            IsEnabled="{Binding HasDifferences}"
                            ToolTip="{Binding UpdateReferenceButtonTooltip}"
                            ToolTipService.ShowOnDisabled="True"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" 
                                                     Width="16" 
                                                     Height="16"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,4,0" />
                            <TextBlock Text="{Binding UpdateReferenceButtonText}"
                                       d:Text="Save to reference"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0"
                            Command="{Binding DiscardChangesCommand}"
                            IsEnabled="{Binding HasDifferences}"
                            ToolTip="{Binding DiscardChangesButtonTooltip}"
                            ToolTipService.ShowOnDisabled="True"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Delete" 
                                                     Width="16" 
                                                     Height="16"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,4,0" />
                            <TextBlock Text="{Binding DiscardChangesButtonText}"
                                       d:Text="Restore from reference"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding CloseButtonText}"
                            d:Content="Close"
                            Margin="8,0,0,0"
                            IsCancel="True"
                            Click="OnCloseClicked"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
            </Grid>
        </DockPanel>
        
        <!-- Configuration Invalid Overlay -->
        <controls:ConfigInvalidOverlay d:Visibility="Collapsed"
                                      Visibility="{Binding ShowOverlay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Panel.ZIndex="1000" />
    </Grid>
</Window>
