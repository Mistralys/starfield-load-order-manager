<Window x:Class="LoadOrderKeeper.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LoadOrderKeeper.Models"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="494"
        Width="560"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesignPaper}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <DockPanel Margin="16" Background="{DynamicResource MaterialDesignPaper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Description}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialDesignBody}" />

            <Border Grid.Row="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    Background="{DynamicResource MaterialDesignCardBackground}">
                <ListView x:Name="DiffListView" ItemsSource="{Binding DiffLines}"
                          Margin="0"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Added}">
                                    <Setter Property="Background" Value="#1A4CAF50" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Removed}">
                                    <Setter Property="Background" Value="#1AF44336" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChangeType}" Value="{x:Static models:DiffChangeType.Moved}">
                                    <Setter Property="Background" Value="#1A2196F3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DiffLineModel}">
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding Prefix}"
                                           FontWeight="Bold"
                                           Width="16"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MaterialDesignBody}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <TextBlock Grid.Row="2"
                       Text="{Binding DiffStatusMessage}"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Grid.Row="3"
                        Text="No differences detected."
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource MaterialDesignBodyLight}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDifferences}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Row="4"
                         Orientation="Horizontal"
                         HorizontalAlignment="Right"
                         Margin="0,16,0,0">
                <Button Content="Discard changes"
                        Margin="0,0,8,0"
                        Command="{Binding DiscardChangesCommand}"
                        IsEnabled="{Binding HasDifferences}"
                        Style="{StaticResource MaterialDesignFlatButton}" />
                <Button Content="{Binding FixLoadOrderButtonText}"
                        Margin="0,0,8,0"
                        Command="{Binding FixLoadOrderCommand}"
                        IsEnabled="{Binding HasDifferences}"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="{Binding UpdateReferenceButtonText}"
                        Command="{Binding UpdateReferenceCommand}"
                        IsEnabled="{Binding HasDifferences}"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Close"
                        Margin="8,0,0,0"
                        IsCancel="True"
                        Click="OnCloseClicked"
                        Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
