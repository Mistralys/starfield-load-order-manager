<Window x:Class="LoadOrderKeeper.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding Texts.WindowTitle}"
        d:Title="An unexpected error occurred"
        Height="420"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignDefaultWindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Error Icon and Title -->
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="AlertCircle" 
                                   Width="48" 
                                   Height="48" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignValidationErrorBrush}" />
            <TextBlock Text="{Binding Texts.ErrorHeaderText}"
                       d:Text="An Unexpected Error Occurred"
                       FontSize="24" 
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="{DynamicResource MaterialDesignBody}" />
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource MaterialDesignBody}" />

        <!-- Error Details Card -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="16"
                CornerRadius="4"
                Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ErrorDetails}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
            </ScrollViewer>
        </Border>

        <!-- Primary Action Buttons -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0"
                    Content="{Binding Texts.OpenLogFolderButtonText}"
                    d:Content="Open Log Folder"
                    MinWidth="130"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenLogFolderCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="{Binding Texts.OpenLogFolderTooltip}" />
            <Button Grid.Column="1"
                    Content="{Binding Texts.ReportBugButtonText}"
                    d:Content="Report Bug"
                    MinWidth="130"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding ReportBugCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="{Binding Texts.ReportBugTooltip}" />
        </Grid>

        <!-- Secondary Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0"
                    Content="{Binding Texts.ExitButtonText}"
                    d:Content="Exit"
                    MinWidth="130"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    ToolTip="{Binding Texts.ExitTooltip}" />
            <Button Grid.Column="1"
                    Content="{Binding Texts.IgnoreButtonText}"
                    d:Content="Ignore (Unsafe)"
                    MinWidth="130"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding IgnoreCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                    ToolTip="{Binding Texts.IgnoreTooltip}" />
        </Grid>
    </Grid>
</Window>
