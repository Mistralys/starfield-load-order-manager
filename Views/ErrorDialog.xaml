<Window x:Class="LoadOrderKeeper.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="An unexpected error occurred"
        Height="420"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignDefaultWindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Error Icon and Title -->
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="AlertCircle" 
                                   Width="48" 
                                   Height="48" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignValidationErrorBrush}" />
            <TextBlock Text="An Unexpected Error Occurred" 
                       FontSize="24" 
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="{DynamicResource MaterialDesignBody}" />
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource MaterialDesignBody}" />

        <!-- Error Details Card -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="16"
                CornerRadius="4"
                Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ErrorDetails}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
            </ScrollViewer>
        </Border>

        <!-- Primary Action Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
            <Button Content="Open Log Folder"
                    MinWidth="130"
                    Margin="0,0,8,0"
                    Command="{Binding OpenLogFolderCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="Opens the folder containing the error.log file" />
            <Button Content="Report Bug"
                    MinWidth="130"
                    Margin="8,0,0,0"
                    Command="{Binding ReportBugCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="Opens GitHub issues page to report this error" />
        </StackPanel>

        <!-- Secondary Action Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="Exit"
                    MinWidth="130"
                    Margin="0,0,8,0"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    ToolTip="Exit the application (recommended)" />
            <Button Content="Ignore (Unsafe)"
                    MinWidth="130"
                    Margin="8,0,0,0"
                    Command="{Binding IgnoreCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                    ToolTip="Continue running - application may be in an unstable state" />
        </StackPanel>
    </Grid>
</Window>
