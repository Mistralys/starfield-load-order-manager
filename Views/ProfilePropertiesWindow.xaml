<Window x:Class="LoadOrderKeeper.Views.ProfilePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}"
        Height="350"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignDefaultWindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Label -->
        <TextBlock Grid.Row="0"
                   Text="{Binding LabelLabelText}"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
        <TextBox Grid.Row="1"
                 x:Name="LabelTextBox"
                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="30"
                 Margin="0,0,0,8"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Enter profile label"
                 Foreground="{DynamicResource MaterialDesignBodyLight}" />
        <TextBlock Grid.Row="2"
                   Text="{Binding LabelError}"
                   Margin="0,0,0,12"
                   Foreground="#F44336"
                   FontSize="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LabelError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LabelError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Description -->
        <TextBlock Grid.Row="3"
                   Text="{Binding DescriptionLabelText}"
                   Margin="0,8,0,4"
                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
        <TextBox Grid.Row="4"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="500"
                 MinHeight="100"
                 Margin="0,0,0,8"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Enter profile description (optional)"
                 Foreground="{DynamicResource MaterialDesignBodyLight}" />
        <TextBlock Grid.Row="5"
                   Text="{Binding DescriptionError}"
                   Margin="0,0,0,12"
                   VerticalAlignment="Top"
                   Foreground="#F44336"
                   FontSize="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DescriptionError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DescriptionError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <Button Content="{Binding SaveButtonText}"
                    Width="100"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button Content="{Binding CancelButtonText}"
                    Width="100"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
        </StackPanel>
    </Grid>
</Window>
