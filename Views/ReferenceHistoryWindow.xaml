<Window x:Class="LoadOrderKeeper.Views.ReferenceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:LoadOrderKeeper.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        d:Title="Reference History"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignDefaultWindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}"
        d:DesignHeight="600" d:DesignWidth="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:ChangeSummaryConverter x:Key="ChangeSummaryConverter" />
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Version List -->
        <DataGrid Grid.Row="0"
                  x:Name="VersionDataGrid"
                  ItemsSource="{Binding Versions}"
                  SelectedItem="{Binding SelectedVersion}"
                  Margin="16"
                  Background="{DynamicResource MaterialDesignPaper}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  IsReadOnly="True">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Padding" Value="8,8,8,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           TextWrapping="Wrap" 
                                           TextAlignment="Center" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding DataContext.VersionColumnHeader, RelativeSource={RelativeSource AncestorType=Window}}"
                                    d:Header="Version"
                                    Width="80" 
                                    Binding="{Binding VersionNumber}" />
                <DataGridTextColumn Header="{Binding DataContext.DateColumnHeader, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    d:Header="Date"
                                    Width="160" 
                                    Binding="{Binding FormattedTimestamp}" />
                <DataGridTextColumn Header="{Binding DataContext.ChangesColumnHeader, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    d:Header="Changes"
                                    Width="100" 
                                    Binding="{Binding TotalModsChanged}" />
                <DataGridTextColumn Header="{Binding DataContext.SummaryColumnHeader, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    d:Header="Summary"
                                    Width="*" 
                                    Binding="{Binding ., Converter={StaticResource ChangeSummaryConverter}}" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                    <EventSetter Event="MouseDoubleClick" Handler="OnVersionDoubleClick" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- No Versions Message -->
        <TextBlock Grid.Row="0"
                   Text="{Binding NoVersionsMessage}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                   Visibility="{Binding HasVersions, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="4"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="16">
            <Button Content="{Binding RollbackButtonText}"
                    d:Content="Rollback..."
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Command="{Binding RollbackCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button Content="{Binding DeleteVersionButtonText}"
                    d:Content="Delete version"
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Command="{Binding DeleteVersionCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button Content="{Binding ClearHistoryButtonText}"
                    d:Content="Clear all history..."
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Command="{Binding ClearHistoryCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button Content="{Binding CloseButtonText}"
                    d:Content="Close"
                    MinWidth="80"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
        </StackPanel>
    </Grid>
</Window>
