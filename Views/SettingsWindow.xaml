<Window x:Class="LoadOrderKeeper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Load Order Keeper Settings"
        Height="435"
        Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignDefaultWindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="InverseBooleanToVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,4"
                   Text="Starfield AppData Path:"
                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
        <TextBox Grid.Row="1"
                 Grid.Column="0"
                 Margin="0,0,8,8"
                 MinWidth="360"
                 Text="{Binding StarfieldAppDataPath, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Starfield AppData Path"
                 Foreground="{DynamicResource MaterialDesignBodyLight}" />
        <Button Grid.Row="1"
                Grid.Column="1"
                Content="Browse..."
                Width="90"
                Margin="0,0,0,8"
                Command="{Binding BrowseAppDataCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        
        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBlock Text="Detected: "
                       FontSize="11"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Padding="0"
                    Height="Auto"
                    MinHeight="0"
                    VerticalAlignment="Center"
                    Command="{Binding UseDetectedAppDataPathCommand}"
                    Visibility="{Binding HasDetectedAppDataPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding DetectedAppDataPath, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           TextDecorations="None" />
            </Button>
            <TextBlock Text="(None found)"
                       FontSize="11"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       DataContext="{Binding HasDetectedAppDataPath}"
                       Style="{StaticResource InverseBooleanToVisibilityStyle}" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="0,8,0,4"
                   Text="Starfield Game Path:"
                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
        <TextBox Grid.Row="4"
                 Grid.Column="0"
                 Margin="0,0,8,8"
                 Text="{Binding StarfieldGamePath, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Starfield Game Path"
                 Foreground="{DynamicResource MaterialDesignBodyLight}" />
        <Button Grid.Row="4"
                Grid.Column="1"
                Content="Browse..."
                Width="90"
                Margin="0,0,0,8"
                Command="{Binding BrowseGamePathCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}" />

        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBlock Text="Detected: "
                       FontSize="11"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Padding="0"
                    Height="Auto"
                    MinHeight="0"
                    VerticalAlignment="Center"
                    Command="{Binding UseDetectedGamePathCommand}"
                    Visibility="{Binding HasDetectedGamePath, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding DetectedGamePath, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           TextDecorations="None" />
            </Button>
            <TextBlock Text="(None found)"
                       FontSize="11"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       DataContext="{Binding HasDetectedGamePath}"
                       Style="{StaticResource InverseBooleanToVisibilityStyle}" />
        </StackPanel>

        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="0,8,0,4"
                   Text="Check for modifications every (seconds):"
                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
        <TextBox Grid.Row="7"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Margin="0,0,8,8"
                 Text="{Binding PluginCheckIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Interval in seconds"
                 Foreground="{DynamicResource MaterialDesignBodyLight}" />

        <StackPanel Grid.Row="8"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <Button Content="Save"
                    Width="100"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
