<Window x:Class="LoadOrderKeeper.Views.UpdateOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        d:Title="Download Update"
        Width="500"
        Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignDefaultWindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}">

    <Border Padding="24">
        <StackPanel>
            <!-- Icon and Message -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <materialDesign:PackIcon Kind="Download"
                                        Width="48"
                                        Height="48"
                                        VerticalAlignment="Top"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Margin="0,0,16,0" />
                <TextBlock Text="{Binding MessageText}"
                          d:Text="A new version is available!&#x0a;&#x0a;Current version: 1.0.0&#x0a;Latest version: 1.1.0&#x0a;&#x0a;Choose your preferred download source:"
                          TextWrapping="Wrap"
                          VerticalAlignment="Center"
                          FontSize="14"
                          Foreground="{DynamicResource MaterialDesignBody}" />
            </StackPanel>

            <!-- Download Buttons -->
            <Button Content="{Binding NexusmodsButtonText}"
                    d:Content="Open on Nexusmods"
                    Command="{Binding OpenNexusmodsCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="56"
                    Margin="0,0,0,12"
                    HorizontalContentAlignment="Left"
                    Padding="16,0">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Web"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0" />
                            <TextBlock Text="{Binding}"
                                      VerticalAlignment="Center"
                                      FontSize="16" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>

            <Button Content="{Binding GitHubButtonText}"
                    d:Content="Open on GitHub"
                    Command="{Binding OpenGitHubCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="56"
                    Margin="0,0,0,24"
                    HorizontalContentAlignment="Left"
                    Padding="16,0">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Github"
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0" />
                            <TextBlock Text="{Binding}"
                                      VerticalAlignment="Center"
                                      FontSize="16" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>

            <!-- Cancel Button -->
            <Button Content="{Binding CancelButtonText}"
                    d:Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Center"
                    IsCancel="True" />
        </StackPanel>
    </Border>
</Window>
