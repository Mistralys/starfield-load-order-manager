<Window x:Class="LoadOrderKeeper.Views.ViewPendingChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:LoadOrderKeeper.Converters"
        xmlns:controls="clr-namespace:LoadOrderKeeper.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        d:Title="Pending Changes"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignDefaultWindowStyle}"
        Background="{DynamicResource MaterialDesignPaper}"
        d:DesignHeight="500" d:DesignWidth="600">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Explanation Text -->
        <Border Grid.Row="0"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1"
                Padding="16,16,16,12">
            <TextBlock Text="{Binding ExplanationText}"
                       d:Text="This shows all changes you have made since the last reference update. When you next update the reference file, these changes will be archived."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       FontSize="14" />
        </Border>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="4"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Content Area (ScrollViewer for changes or message) -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16">
            <StackPanel>
                <!-- No Pending Changes Message -->
                <TextBlock Text="{Binding NoPendingChangesMessage}"
                           d:Text="No pending changes."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,48,0,0"
                           FontSize="16"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Visibility="{Binding HasPendingChanges, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <!-- Pending Changes Content -->
                <StackPanel Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Comment Section -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{Binding CommentLabel}"
                                   d:Text="Comment:"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBlock Text="{Binding CommentDisplay}"
                                   d:Text="This is my comment about the changes"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Padding="12"
                                   Background="{DynamicResource MaterialDesignCardBackground}"
                                   Foreground="{DynamicResource MaterialDesignBody}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontStyle" Value="Normal" />
                                    <Style.Triggers>
                                        <!-- Make placeholder text italic -->
                                        <DataTrigger Binding="{Binding Comment}" Value="">
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Added Mods Section -->
                    <StackPanel Margin="0,0,0,16"
                                Visibility="{Binding HasAddedMods, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding AddedModsLabel}"
                                   d:Text="Added Mods:"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <ItemsControl ItemsSource="{Binding AddedMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                            Margin="0,0,0,4"
                                            Padding="12,8"
                                            CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Tertiary}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding}"
                                                       d:Text="ModName.esp"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Removed Mods Section -->
                    <StackPanel Margin="0,0,0,16"
                                Visibility="{Binding HasRemovedMods, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding RemovedModsLabel}"
                                   d:Text="Removed Mods:"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <ItemsControl ItemsSource="{Binding RemovedMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                            Margin="0,0,0,4"
                                            Padding="12,8"
                                            CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Minus"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding}"
                                                       d:Text="OldMod.esp"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <Border Grid.Row="3"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Padding="16">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="{Binding EditCommentButtonText}"
                        d:Content="Edit comment..."
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Command="{Binding EditCommentCommand}"
                        IsEnabled="{Binding HasPendingChanges}"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="{Binding CloseButtonText}"
                        d:Content="Close"
                        MinWidth="80"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </Border>
        
        <!-- Configuration Invalid Overlay -->
        <controls:ConfigInvalidOverlay Grid.RowSpan="5"
                                      d:Visibility="Collapsed"
                                      Visibility="{Binding ShowOverlay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Panel.ZIndex="1000" />
    </Grid>
</Window>
