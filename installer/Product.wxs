<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="Starfield Load Order Keeper"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="Mistralys"
      UpgradeCode="e3c0d9a9-6902-46f7-8912-0f12978a8431">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="x64" />

    <MajorUpgrade
        AllowDowngrades="no"
        DowngradeErrorMessage="A newer version of Starfield Load Order Keeper is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Installation directory -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Starfield Load Order Keeper">
          <Directory Id="ViewTextsFolder" Name="ViewTexts">
            <Directory Id="LocalesFolder" Name="Locales" />
          </Directory>
        </Directory>
      </Directory>

      <!-- Start Menu folder -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Starfield Load Order Keeper" />
      </Directory>
    </Directory>

    <!-- Files -->
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Main executable (single-file deployment; the csproj embeds the WPF native DLLs via IncludeNativeLibrariesForSelfExtract, the locale JSON files ship separately, see below) -->
      <Component Id="MainExecutable" Guid="0b7e8c4e-3e4a-4e0b-9c3e-2a0f2f8b8c11" Win64="yes">
        <File
            Id="AppExe"
            Source="$(var.PublishDir)\StarfieldLoadOrderKeeper.exe"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Localization files: LocalizationService loads ViewTexts\Locales\*.json from the app directory -->
    <DirectoryRef Id="LocalesFolder">
      <Component Id="LocaleFiles" Guid="fbbbe5a9-d654-4299-a7e9-60b82e427da7" Win64="yes">
        <File Id="Locale_en_US" Source="$(var.PublishDir)\ViewTexts\Locales\en-US.json" KeyPath="yes" />
        <File Id="Locale_de_DE" Source="$(var.PublishDir)\ViewTexts\Locales\de-DE.json" />
        <File Id="Locale_es_ES" Source="$(var.PublishDir)\ViewTexts\Locales\es-ES.json" />
        <File Id="Locale_fr_FR" Source="$(var.PublishDir)\ViewTexts\Locales\fr-FR.json" />
        <File Id="Locale_it_IT" Source="$(var.PublishDir)\ViewTexts\Locales\it-IT.json" />
        <File Id="Locale_ja_JP" Source="$(var.PublishDir)\ViewTexts\Locales\ja-JP.json" />
        <File Id="Locale_pt_BR" Source="$(var.PublishDir)\ViewTexts\Locales\pt-BR.json" />
        <File Id="Locale_zh_CN" Source="$(var.PublishDir)\ViewTexts\Locales\zh-CN.json" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu Shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="f1a7b3c2-9d4e-4f8b-8a1c-3e2d7c4b1f33" Win64="yes">
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="Starfield Load Order Keeper"
            Target="[INSTALLFOLDER]StarfieldLoadOrderKeeper.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\StarfieldLoadOrderKeeper"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="Starfield Load Order Keeper" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="LocaleFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Installer dialog: license and install button, progress, finish screen.
         The RTF license text is generated from LICENSE by Tools/BuildMsi.ps1. -->
    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

  </Product>
</Wix>
